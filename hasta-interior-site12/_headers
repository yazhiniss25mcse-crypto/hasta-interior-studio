# Cloudflare Pages — custom response headers

/*
  Access-Control-Allow-Origin: *

# Font files: allow cross-origin access so browsers can load them
/assets/fonts/*.woff2
  Access-Control-Allow-Origin: *
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*.woff
  Access-Control-Allow-Origin: *
  Content-Type: font/woff
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*.eot
  Access-Control-Allow-Origin: *
  Content-Type: application/vnd.ms-fontobject
  Cache-Control: public, max-age=31536000, immutable

# CSS files
/assets/css/*.css
  Cache-Control: public, max-age=2592000
  Access-Control-Allow-Origin: *

# JS files
/assets/js/*.js
  Cache-Control: public, max-age=2592000
  Access-Control-Allow-Origin: *

# Images: rarely change once uploaded — cache for a year, rename the file if replacing one
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/project-images/*
  Cache-Control: public, max-age=31536000, immutable
